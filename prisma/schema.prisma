// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(cuid())

  // Authentication
  phone                String?  @unique @db.VarChar(10)
  email                String?  @unique

  provider             AuthProvider @default(PHONE)

  // Profile
  name                 String?
  image                String?
  dob                  DateTime?
  gender               Gender?

  // Address
  houseNo              String?
  address              String?
  landmark             String?
  pinCode              String?  @db.VarChar(6)

  // Status
  isVerified           Boolean  @default(false)
  isProfileCompleted   Boolean  @default(false)
    hasCompletedOnboarding Boolean @default(false)

  // Welcome Offer
  freeCallPopupShown   Boolean  @default(false)
  freeCallMinutes      Int      @default(5)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  otpVerifications     OTPVerification[]
  bookings             Booking[]

  @@index([phone])
  @@index([email])
}


model OTPVerification {
  id          String   @id @default(cuid())

  identifier  String
  otp         String
  verified    Boolean  @default(false)

  expiresAt   DateTime

  createdAt   DateTime @default(now())

  userId      String?

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
}

model Booking {
  id                String   @id @default(cuid())
  bookingId         String   @unique

  // User relation
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Pooja details
  poojaId           Int
  poojaTitle        String
  poojaMode         PoojaMode
  poojaImage        String?
  duration          String?

  // Pricing
  amount            Int
  originalPrice     Int?
  discount          Int?

  // Contact details (stored separately for record)
  customerName      String
  customerPhone     String   @db.VarChar(10)
  customerEmail     String

  // Address (for on-site poojas)
  houseNo           String?
  address           String?
  landmark          String?
  pinCode           String?  @db.VarChar(6)

  // Scheduling
  scheduledDate     String   // Stored as YYYY-MM-DD
  timeSlot          TimeSlot
  
  // Payment details
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?

  // Status
  status            BookingStatus @default(CONFIRMED)
  paymentStatus     PaymentStatus @default(PAID)

  // Notes
  specialRequests   String?
  panditNotes       String?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?

  @@index([userId])
  @@index([bookingId])
  @@index([scheduledDate])
  @@index([status])
}

enum PoojaMode {
  VIDEO_CALL
  AT_HOME
}

enum TimeSlot {
  SLOT_8_12    // 8:00 AM - 12:00 PM
  SLOT_12_15   // 12:00 PM - 3:00 PM
  SLOT_15_19   // 3:00 PM - 7:00 PM
  SLOT_19_22   // 7:00 PM - 10:00 PM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AuthProvider {
  PHONE
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}